# Chave da API da Anthropic. Obrigatória para reescrever texto.
# Obtém uma em https://console.anthropic.com/ e nunca a coloques no código nem em ficheiros versionados.
ANTHROPIC_API_KEY=

# Modelo utilizado nas reescritas. Podes trocar por outro identificador suportado pela API.
PROSA_MODEL=claude-opus-5-5

# Esforço de raciocínio do modelo: low | medium | high | xhigh | max
# "medium" é um bom equilíbrio entre qualidade e custo para revisão de texto.
PROSA_EFFORT=medium

# Dimensão máxima de cada secção enviada ao modelo (em palavras). Documentos longos são
# divididos por parágrafos até este limite e processados em sequência, com contexto partilhado.
PROSA_SECTION_WORDS=650

# Limite de caracteres aceites por pedido (protege contra pedidos acidentais demasiado grandes).
PROSA_MAX_INPUT_CHARS=80000

# Máximo de tokens gerados por secção.
PROSA_MAX_OUTPUT_TOKENS=16000
