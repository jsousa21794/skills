# Fornecedor de IA: "ollama" (local, sem chave) ou "openai".
PROSA_PROVIDER=ollama

# --- Ollama (https://ollama.com) ---
# Endereço da API do Ollama (compatível com OpenAI em /v1; a Prosa usa também a API nativa em /api).
OLLAMA_BASE_URL=http://localhost:11434/v1
# Modelo instalado localmente. Instala com: ollama pull <modelo>
# Recomendados para português europeu (vê o README): hf.co/csoares31/AMALIA-9B-0626-DPO-GGUF:Q6_K,
# hf.co/PORTULAN/gervasio-8b-portuguese-ptpt-decoder-quantized-4bit, hf.co/bartowski/utter-project_EuroLLM-22B-Instruct-2512-GGUF:Q4_K_M
# Generalistas para as quatro variantes: gemma3:12b, gemma3:27b, qwen3:14b, mistral-small3.2
OLLAMA_MODEL=gemma3:12b
# Janela de contexto pedida em cada pedido (tokens). O endpoint /v1 do Ollama ignora este valor,
# por isso a Prosa usa a API nativa. Sem isto, o Ollama usa 4096 em máquinas com menos de 24 GiB de VRAM.
OLLAMA_NUM_CTX=8192
# Tempo que o modelo fica carregado em memória entre pedidos.
OLLAMA_KEEP_ALIVE=10m
# Só é necessário se tiveres protegido o Ollama com um proxy que exige chave.
# OLLAMA_API_KEY=

# --- OpenAI (ou serviços compatíveis com a API da OpenAI) ---
# Chave da API. Obtém uma em https://platform.openai.com/api-keys e nunca a coloques no código.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Altera apenas se usares um serviço compatível (Azure OpenAI, Groq, Together, LM Studio, Maritaca, etc.).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Verificações ---
# Verificação de sentido por embeddings: compara cada parágrafo original com o revisto.
# "on" (predefinição) ou "off". Com Ollama usa por defeito o modelo bge-m3 (ollama pull bge-m3);
# com OpenAI usa text-embedding-3-small.
PROSA_MEANING_CHECK=on
# PROSA_EMBED_MODEL=bge-m3
# Limiar de semelhança (cosseno) abaixo do qual um parágrafo gera aviso. Calibra com scripts/calibrate-similarity.mjs.
PROSA_SIMILARITY_MIN=0.72
# Re-revisão automática dos parágrafos com padrões típicos de IA ou marcas de outra variante: "on" ou "off".
PROSA_AUTO_POLISH=on
# Máximo de parágrafos re-revistos por secção (cada um é um pedido adicional ao modelo).
PROSA_MAX_POLISH=3
# Servidor LanguageTool auto-alojado (opcional). Exemplo: docker run -p 8010:8010 erikvl87/languagetool
# LANGUAGETOOL_URL=http://localhost:8010

# --- Comportamento ---
# Temperatura da geração (0 a 2). Valores baixos dão reescritas mais fiéis.
PROSA_TEMPERATURE=0.4
# Dimensão máxima de cada secção enviada ao modelo (em palavras). Predefinição: 400 com Ollama, 650 com OpenAI.
# PROSA_SECTION_WORDS=400
# Limite de caracteres aceites por pedido.
PROSA_MAX_INPUT_CHARS=80000
# Máximo de tokens gerados por secção.
PROSA_MAX_OUTPUT_TOKENS=4000
