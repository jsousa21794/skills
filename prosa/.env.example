# Fornecedor de IA: "ollama" (local, sem chave) ou "openai".
PROSA_PROVIDER=ollama

# --- Ollama (https://ollama.com) ---
# Endereço da API compatível com OpenAI exposta pelo Ollama (termina em /v1).
OLLAMA_BASE_URL=http://localhost:11434/v1
# Modelo instalado localmente. Instala com: ollama pull <modelo>
# Sugestões: llama3.1, qwen2.5:14b, gemma3:12b, mistral-nemo. Modelos maiores reescrevem melhor.
OLLAMA_MODEL=llama3.1
# Só é necessário se tiveres protegido o Ollama com um proxy que exige chave.
# OLLAMA_API_KEY=

# --- OpenAI (ou serviços compatíveis com a API da OpenAI) ---
# Chave da API. Obtém uma em https://platform.openai.com/api-keys e nunca a coloques no código.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Altera apenas se usares um serviço compatível (Azure OpenAI, Groq, Together, LM Studio, etc.).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Comportamento ---
# Temperatura da geração (0 a 2). Valores baixos dão reescritas mais fiéis.
PROSA_TEMPERATURE=0.4
# Dimensão máxima de cada secção enviada ao modelo (em palavras). Predefinição: 400 com Ollama, 650 com OpenAI.
# Com modelos locais de contexto curto, mantém este valor baixo.
# PROSA_SECTION_WORDS=400
# Limite de caracteres aceites por pedido.
PROSA_MAX_INPUT_CHARS=80000
# Máximo de tokens gerados por secção.
PROSA_MAX_OUTPUT_TOKENS=4000
